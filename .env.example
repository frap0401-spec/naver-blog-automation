# Claude API 키 (https://console.anthropic.com 에서 발급)
ANTHROPIC_API_KEY=sk-ant-...

# (선택) 타입캐스트 목소리 — https://typecast.ai/developers 에서 API 키 발급 (유료 플랜 필요할 수 있음)
# TYPECAST_API_KEY=
# TYPECAST_EMOTION=normal        # normal / happy / toneup / tonedown
# TYPECAST_VOICES=tc_xxx:이름     # 목록 대신 직접 고른 목소리만 쓰고 싶을 때

# (선택) 클로바 보이스 — 클로바 더빙과 같은 네이버 음성. 네이버 클라우드 콘솔에서
#   AI·NAVER API > Application 등록 > CLOVA Voice 선택 후 Client ID / Client Secret 발급 (사용량만큼 과금)
# NCP_CLOVA_CLIENT_ID=
# NCP_CLOVA_CLIENT_SECRET=
# NCP_CLOVA_SPEAKERS=nara:아라:여성,nminsang:민상:남성   # 목록 바꾸고 싶을 때

# (선택) ElevenLabs 목소리 — https://elevenlabs.io 의 Profile > API Keys 에서 발급
# 넣으면 3단계 목소리 목록에 내 ElevenLabs 목소리(라이브러리에서 추가한 한국어 목소리 포함)가 나옵니다.
# ELEVENLABS_API_KEY=
# ELEVENLABS_MODEL=eleven_multilingual_v2   # 더 자연스러운 eleven_v3 도 가능

# 선택 설정
# DROPCUT_WHISPER=small              # 받아쓰기 모델: small(기본) / medium(더 정확, 느림)
# DROPCUT_MODEL=claude-opus-5-5
# DROPCUT_EFFORT=high
# DROPCUT_FONT=Malgun Gothic        # 자막 글꼴 이름 (assets/fonts 에 넣은 글꼴도 사용 가능)
# DROPCUT_ZOOM=1.06                 # 원본 테두리/워터마크를 살짝 잘라내는 확대 비율
# DROPCUT_BGM_VOLUME=0.12
# DROPCUT_LLM=mock                  # API 키 없이 화면 테스트
# DROPCUT_TTS=dummy                 # 인터넷 없이 테스트(삐 소리)
